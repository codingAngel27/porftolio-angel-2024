---
import ExperienciaItem from "./ExperienciaItem.astro";
const EXPERIENCE = [
    {
        date: "Ene 2025 – Dic 2025",
        title: "Desarrollador fullstack - Intratek Perú E.I.R.L.",
        description:
            "Desarrollé microservicios con Java 17 y Spring Boot bajo una arquitectura modular, implementando controladores reactivos con Spring WebFlux para comunicación no bloqueante y aplicando patrones de microservicios. Gestioné la contenerización con Docker y el despliegue en entornos Microsoft Azure, incorporando seguridad mediante JWT y Spring Security. En el frontend, desarrollé dashboards empresariales (login, ventas, inventario, cotizaciones y facturación) utilizando Angular con TypeScript, implementando Guards, Interceptors, manejo avanzado de HttpClient, arquitectura basada en servicios, Reactive Forms y uso de Observables con patrones RxJS en flujos críticos. Además, realicé versionamiento y automatización de pipelines CI/CD mediante GitLab.",
        link: "/",
    },
    {
        date: "Sep 2024 – Ene 2025",
        title: "Auxiliar de TI - Nextcode Sac",
        description:
            "Integré microservicios desarrollados con NestJS y Node para conectar sistemas ERP/CRM, implementando procesos reactivos con RxJS y automatizaciones con IA mediante OpenAI y n8n para generar resúmenes inteligentes de negociaciones dentro de la plataforma. Gestioné APIs, despliegues con Docker y versionamiento con Git, logrando una mejora del 50% en tiempos de respuesta y reducción significativa de tareas manuales gracias a la automatización.",
        link: "/",
    },
    {
        date: "2024 - Proyecto Personal destacado",
        title: "E-Commerce de Productos Artesanales con Spring Boot y Thymeleaf",
        description:
            "Desarrollé un sistema de comercio electrónico enfocado en productos artesanales, implementando un backend robusto en Java Spring Boot con el patrón MVC y un frontend dinámico basado en Thymeleaf. El sistema utiliza Spring Security para la autenticación y autorización de usuarios, asegurando una gestión segura de sesiones y roles. Los controladores manejan las solicitudes del frontend, garantizando una comunicación eficiente entre capas. El proyecto incluye módulos para gestión de productos, carrito de compras, autenticación de usuarios y panel administrativo, destacando por su diseño responsivo, arquitectura limpia y buenas prácticas de desarrollo fullstack.",
        link: "/",
    },
    {
        date: "2023 - Proyecto Personal destacado",
        title: "E-Commerce con React JS y TailwindCSS",
        description:
            "Diseñé y desarrollé componentes interactivos en React JS para mejorar la experiencia del usuario. Integré TailwindCSS para lograr un diseño responsivo y atractivo. Implementé funcionalidades clave como carrito de compras y gestión de productos, optimizando el rendimiento del sitio y asegurando una alineación efectiva entre requisitos y desarrollo técnico.",
        link: "/",
    },
];
---

<ol
    class="relative border-s border-gray-200 dark:border-gray-700 w-[70%] text-balance flex m-auto flex-wrap justify-center gap-x-10 items-center"
>
    {
        EXPERIENCE.map((experiencie) => (
            <li class="mb-10 ms-4">
                <ExperienciaItem {...experiencie} />
            </li>
        ))
    }
</ol>

